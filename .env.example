# Copy to .env. Never commit .env.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
AIRFLOW_DB_PASSWORD=change-me-airflow
MOVIE_DB_PASSWORD=change-me-movies

# Generate unique values before starting Airflow. These must be shared by all
# Airflow components and must never be committed.
AIRFLOW_API_SECRET_KEY=change-me-api-secret
AIRFLOW_JWT_SECRET=change-me-jwt-secret
AIRFLOW_FERNET_KEY=change-me-valid-fernet-key

# Windows path exposed to containers by Docker Desktop.
MOVIES_SOURCE_PATH=D:/amazon/movies.txt.gz

# Airflow Simple Auth Manager user:role pairs for local development only.
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin

# Optional sources. Leave blank until the account/key and use terms are approved.
TMDB_API_TOKEN=

